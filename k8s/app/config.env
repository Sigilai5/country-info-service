# Non-secret app configuration, injected into the pods as environment variables.
# kustomize turns this into a ConfigMap whose name includes a content hash, so changing a value and
# re-running scripts/deploy.sh automatically rolls the pods onto the new config.
# External MySQL database. host.minikube.internal is the machine running minikube (the local Docker
# MySQL on port 3306); in a real environment use the managed database endpoint, e.g.
# jdbc:mysql://countrydb.xxxx.eu-west-1.rds.amazonaws.com:3306/countrydb
DB_URL=jdbc:mysql://host.minikube.internal:3306/countrydb
DB_POOL_SIZE=10
SOAP_COUNTRY_INFO_URL=http://webservices.oorsprong.org/websamples.countryinfo/CountryInfoService.wso
SOAP_CONNECT_TIMEOUT=3s
SOAP_READ_TIMEOUT=5s
APP_LOG_LEVEL=INFO
LOG_PATH=/tmp/logs
